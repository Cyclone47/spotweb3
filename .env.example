# Optional first-boot configuration. Leave blank to use the setup wizard.
SPOTWEB_ADMIN_PASSWORD=
SPOTWEB_SKIP_ONBOARDING=
SPOTWEB_NNTP_HOST=
SPOTWEB_NNTP_USER=
SPOTWEB_NNTP_PASS=
SPOTWEB_NNTP_ENCRYPTION=tls
SPOTWEB_RETRIEVE_INTERVAL=900
# Required only when enabling the optional PostgreSQL profile.
SPOTWEB_DB_PASS=

# Optional credentials for your own Twitter application.
SPOTWEB_TWITTER_CONSUMER_KEY=
SPOTWEB_TWITTER_CONSUMER_SECRET=
